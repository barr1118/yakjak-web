rules_version = '2';

// YakJak security rules.
// Paste into Firebase Console → Firestore Database → Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    // Public destination catalog. Reads are open; writes stay console-only
    // (admins add/edit places from the Firebase Console for now).
    match /places/{placeId} {
      allow read: if true;
      allow write: if false;
    }

    // Per-user private data: favorites + expedition history.
    // Users can only touch their own uid.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /favorites/{favId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /history/{histId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Community reviews: readable by everyone (incl. logged-out visitors),
    // writable only by the signed-in author of each review.
    // Shape: places/{slug} is referenced via field `placeSlug`.
    // Fields: placeSlug:string, userId:string, userName:string,
    //         rating:number 1..5, text:string, createdAt:timestamp
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      allow update, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }
  }
}
